{
  "openapi": "3.1.0",
  "info": {
    "title": "Nunmul notebook lookup relay",
    "version": "1.0.0",
    "description": "SPEC-RX-RELAY-001. Temporary authenticated read-only bridge. No medication state or patient fields."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "relayHealth",
        "x-corthex": {
          "id": "API-RELAY-001",
          "spec": [
            "SPEC-RX-RELAY-001"
          ],
          "omit": {
            "401": "Public liveness only",
            "403": "No user roles",
            "409": "Read only",
            "422": "No request body"
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "No credentials or configuration returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "service"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "service": {
                      "const": "nunmul-rx-relay"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "service": "nunmul-rx-relay"
                }
              }
            }
          },
          "default": {
            "description": "중계 서버가 요청을 완료하지 못했습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_INTERNAL",
                        "message": "중계 서버가 요청을 완료하지 못했습니다."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/query": {
      "post": {
        "operationId": "relayQuery",
        "x-corthex": {
          "id": "API-RELAY-002",
          "spec": [
            "SPEC-RX-RELAY-001"
          ],
          "omit": {
            "403": "Single dedicated bearer, no roles",
            "409": "Read only",
            "422": "Uses 400 consistently",
            "429": "No own rate counter; bounds concurrent work with 503"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "operation",
                      "itemName"
                    ],
                    "properties": {
                      "operation": {
                        "const": "permit"
                      },
                      "itemName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "maker": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "operation",
                      "itemSeq"
                    ],
                    "properties": {
                      "operation": {
                        "const": "explain"
                      },
                      "itemSeq": {
                        "type": "string",
                        "pattern": "^[0-9]{1,20}$"
                      }
                    }
                  }
                ]
              },
              "examples": {
                "permit": {
                  "value": {
                    "operation": "permit",
                    "itemName": "synthetic medicine"
                  }
                },
                "explain": {
                  "value": {
                    "operation": "explain",
                    "itemSeq": "900000101"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Official fields only; an empty list is a successful empty result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "CANCEL_NAME": {},
                          "CHANGE_DATE": {},
                          "ENTP_NAME": {},
                          "ETC_OTC_CODE": {},
                          "ETC_OTC_NAME": {},
                          "ITEM_INGR_NAME": {},
                          "ITEM_NAME": {},
                          "ITEM_SEQ": {},
                          "atpnQesitm": {},
                          "atpnWarnQesitm": {},
                          "depositMethodQesitm": {},
                          "efcyQesitm": {},
                          "intrcQesitm": {},
                          "itemName": {},
                          "itemSeq": {},
                          "seQesitm": {},
                          "updateDe": {},
                          "useMethodQesitm": {}
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "empty": {
                    "value": {
                      "items": []
                    }
                  },
                  "permit": {
                    "value": {
                      "items": [
                        {
                          "ITEM_SEQ": "900000101",
                          "ITEM_NAME": "synthetic medicine",
                          "ENTP_NAME": "synthetic maker",
                          "ETC_OTC_CODE": "일반의약품",
                          "CANCEL_NAME": "정상"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "허용된 약 검색·설명 입력만 사용할 수 있습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_INVALID_INPUT",
                        "message": "허용된 약 검색·설명 입력만 사용할 수 있습니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "중계 인증을 확인해 주세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_UNAUTHORIZED",
                        "message": "중계 인증을 확인해 주세요."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "지원하지 않는 중계 경로입니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_NOT_FOUND",
                        "message": "지원하지 않는 중계 경로입니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 요청 방식입니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_METHOD_NOT_ALLOWED",
                        "message": "지원하지 않는 요청 방식입니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "중계 요청 크기를 초과했습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_TOO_LARGE",
                        "message": "중계 요청 크기를 초과했습니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "노트북에서 공공데이터에 연결하지 못했습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_UPSTREAM_NETWORK_ERROR",
                        "message": "노트북에서 공공데이터에 연결하지 못했습니다."
                      }
                    }
                  },
                  "RELAY_UPSTREAM_API_ERROR": {
                    "value": {
                      "error": {
                        "code": "RELAY_UPSTREAM_API_ERROR",
                        "message": "공공데이터 인증·활용 승인·파라미터를 확인해 주세요."
                      }
                    }
                  },
                  "RELAY_UPSTREAM_INVALID_RESPONSE": {
                    "value": {
                      "error": {
                        "code": "RELAY_UPSTREAM_INVALID_RESPONSE",
                        "message": "공공데이터 응답을 확인할 수 없습니다."
                      }
                    }
                  },
                  "RELAY_UPSTREAM_HTTP_ERROR": {
                    "value": {
                      "error": {
                        "code": "RELAY_UPSTREAM_HTTP_ERROR",
                        "message": "공공데이터 HTTP 요청에 실패했습니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "중계 서버가 다른 조회를 처리 중입니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_BUSY",
                        "message": "중계 서버가 다른 조회를 처리 중입니다."
                      }
                    }
                  },
                  "noKey": {
                    "value": {
                      "error": {
                        "code": "NO_KEY",
                        "message": "노트북에 공공데이터 키가 설정되지 않았습니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "중계 서버가 요청을 완료하지 못했습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "failure": {
                    "value": {
                      "error": {
                        "code": "RELAY_INTERNAL",
                        "message": "중계 서버가 요청을 완료하지 못했습니다."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separate URL-safe relay token, 32-200 characters; never the official service key."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "RELAY_UNAUTHORIZED",
                  "RELAY_INVALID_INPUT",
                  "RELAY_NOT_FOUND",
                  "RELAY_METHOD_NOT_ALLOWED",
                  "RELAY_TOO_LARGE",
                  "RELAY_BUSY",
                  "NO_KEY",
                  "RELAY_UPSTREAM_NETWORK_ERROR",
                  "RELAY_UPSTREAM_API_ERROR",
                  "RELAY_UPSTREAM_INVALID_RESPONSE",
                  "RELAY_UPSTREAM_HTTP_ERROR",
                  "RELAY_INTERNAL"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "x-corthex": {
      "errors": {
        "RELAY_UNAUTHORIZED": {
          "message": "중계 인증을 확인해 주세요."
        },
        "RELAY_INVALID_INPUT": {
          "message": "허용된 약 검색·설명 입력만 사용할 수 있습니다."
        },
        "RELAY_NOT_FOUND": {
          "message": "지원하지 않는 중계 경로입니다."
        },
        "RELAY_METHOD_NOT_ALLOWED": {
          "message": "지원하지 않는 요청 방식입니다."
        },
        "RELAY_TOO_LARGE": {
          "message": "중계 요청 크기를 초과했습니다."
        },
        "RELAY_BUSY": {
          "message": "중계 서버가 다른 조회를 처리 중입니다."
        },
        "NO_KEY": {
          "message": "노트북에 공공데이터 키가 설정되지 않았습니다."
        },
        "RELAY_UPSTREAM_NETWORK_ERROR": {
          "message": "노트북에서 공공데이터에 연결하지 못했습니다."
        },
        "RELAY_UPSTREAM_API_ERROR": {
          "message": "공공데이터 인증·활용 승인·파라미터를 확인해 주세요."
        },
        "RELAY_UPSTREAM_INVALID_RESPONSE": {
          "message": "공공데이터 응답을 확인할 수 없습니다."
        },
        "RELAY_UPSTREAM_HTTP_ERROR": {
          "message": "공공데이터 HTTP 요청에 실패했습니다."
        },
        "RELAY_INTERNAL": {
          "message": "중계 서버가 요청을 완료하지 못했습니다."
        }
      }
    }
  }
}
